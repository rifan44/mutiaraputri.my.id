CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

database.default.hostname = localhost
database.default.database = mutiaraputri_portfolio
database.default.username = portfolio_user
database.default.password = change-this-password
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.DBDebug = true

# Set this to false when running in production.
security.csrfProtection = session
session.cookieName = mutiaraputri_session
